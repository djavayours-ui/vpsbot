# ── majburiy ──
BOT_TOKEN=123456789:AA...                 # @BotFather dan
ADMIN_IDS=111222333                       # bir nechta: 111,222,333

# ── panel ──
WEBAPP_URL=                               # bo'sh = cloudflared bepul tunnel o'zi oladi; "off" = o'chirilgan
WEBAPP_PORT=8080
WEBAPP_HOST=127.0.0.1

# ── ixtiyoriy ──
APPS_DIR=/opt/apps                        # ilovalar joyi
TRASH_DIR=/var/tmp/vpsbot-trash            # savat (7 kun)
ALERT_THRESHOLD=90                        # % — shundan oshsa Telegramga alert
STABLE_SECS=10                            # deploydan keyingi barqarorlik tekshiruvi
AI_MODEL=claude-sonnet-4-5                # AI fix modeli
ANTHROPIC_API_KEY=                        # AI fix uchun (bo'sh bo'lsa o'chadi)
